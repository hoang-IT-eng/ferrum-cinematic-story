{
  "name": "ferrum-cinematic-story",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "images": "node scripts/build-images.mjs",
    "videos": "node scripts/build-videos.mjs",
    "depth:demo": "python scripts/build-depth.py --scenes 1 2",
    "depth:all": "python scripts/build-depth.py --scenes 1 2 3 4 5"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.6",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
